{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "mu-core": ["../mu/packages/core/src"],
      "mu-harness": ["../mu/packages/harness/src"],
      "mu-local-provider": ["../mu/packages/local-provider/src"],
      "mu-tools": ["../mu/packages/tools/src"],
      "mu-webfetch": ["../mu/packages/webfetch/src/plugin"]
    }
  },
  "include": ["packages/**/src/**/*.ts", "packages/**/src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "packages/arya-companion",
    "packages/**/src/**/*.test.ts",
    "packages/**/src/**/*.test.tsx"
  ]
}
