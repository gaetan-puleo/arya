# Arya Agent — Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# OpenAI-compatible API endpoint (Ollama, vLLM, LM Studio, etc.)
# Default: http://localhost:11434/v1
ARYA_BASE_URL=http://localhost:11434/v1

# Model to use (must be available at BASE_URL)
# Default: qwen2.5-coder:7b
ARYA_MODEL=qwen2.5-coder:7b

# ── WebSocket (Companion) ────────────────────────────────────────────────────
# Port for the WebSocket server that the companion app connects to
# Default: 3001
ARYA_WS_PORT=3001

# Auth token for companion connections (empty = no auth)
# Generate a random token: openssl rand -hex 16
ARYA_COMPANION_TOKEN=

# ── Agent Configuration ──────────────────────────────────────────────────────
# Directory for agent definition files (.md)
# Default: ~/.config/arya/agents (or ./definitions/agents if XDG not set)
ARYA_AGENTS_DIR=

# Directory for task definition files (.yaml)
# Default: ~/.config/arya/tasks (or ./definitions/tasks if XDG not set)
ARYA_TASKS_DIR=

# ── Runtime ──────────────────────────────────────────────────────────────────
# Maximum tokens per response
# Default: 4096
ARYA_MAX_TOKENS=4096

# Sampling temperature (0.0-2.0)
# Default: 0.7
ARYA_TEMPERATURE=0.7

# Stream inactivity timeout in milliseconds
# Default: 60000
ARYA_STREAM_TIMEOUT_MS=60000

# Working directory for file/shell tools
# Default: current working directory
ARYA_CWD=
