{
  "tasks": {
    "start": "deno run -A --sloppy-imports packages/arya/src/index.ts serve",
    "tui": "deno run -A --sloppy-imports packages/arya/src/index.ts --channel tui",
    "dev": "deno run -A --watch --sloppy-imports packages/arya/src/index.ts serve",
    "check": "deno check --sloppy-imports packages/arya/src/",
    "test": "deno test -A --sloppy-imports packages/arya/src/",
    "compile": "deno run -A --sloppy-imports scripts/compile.ts"
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "ws": "npm:ws@^8.18.0",
    "croner": "npm:croner@^9.0.0",
    "openai": "npm:openai@^6.38.0",
    "openai/": "npm:/openai@^6.38.0/",
    "turndown": "npm:turndown@^7.2.2",
    "cli-highlight": "npm:cli-highlight@^2.1.11",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "mu-core": "../mu/packages/core/src/index.ts",
    "mu-harness": "../mu/packages/harness/src/index.ts",
    "mu-tui": "../mu/packages/tui/src/index.ts",
    "mu-local-provider": "../mu/packages/local-provider/src/index.ts",
    "mu-tools": "../mu/packages/tools/src/index.ts",
    "mu-webfetch": "../mu/packages/webfetch/src/plugin.ts"
  },
  "unstable": ["sloppy-imports"],
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true
  },
  "exclude": ["**/node_modules", "**/dist", "packages/arya-companion"]
}
