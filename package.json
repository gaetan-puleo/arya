{
  "name": "arya-agent",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "scripts": {
    "dev": "tsx packages/arya/src/index.ts serve",
    "serve": "tsx packages/arya/src/index.ts serve",
    "tui": "tsx packages/arya/src/index.ts --channel tui",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "build": "pnpm --filter arya build",
    "compile": "node scripts/compile.mjs",
    "app:start": "pnpm --filter arya-companion start",
    "app:android": "pnpm --filter arya-companion android",
    "app:ios": "pnpm --filter arya-companion ios"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@yao-pkg/pkg": "^6.20.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
